# Copy to backend\.env on the server PC (start-server.cmd / start-admin.cmd read it).

# sarae-voice-server on this PC: URL and the first token of its SARAE_VOICE_ORCHESTRATOR_TOKENS.
# The token stays on this server; it is never sent to a customer's Studio.
SARAE_TTS_SERVER_URL=http://127.0.0.1:8780
SARAE_TTS_SERVER_TOKEN=
SARAE_TTS_TIMEOUT_SECONDS=10

# Sentences the GPU makes at once (1 for one GPU). Others queue, priority accounts first.
SARAE_GATEWAY_TTS_CONCURRENCY=1

# Where identity.sqlite3 and studio_gateway.sqlite3 live (default backend\data).
# SARAE_DATA_DIR=
