CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Centralized Media Library storage (system-owned; connected once by SUPER_ADMIN in the admin console)
SARAE_STORAGE_PROVIDER=R2
# Admin UI configuration takes precedence over ENV, including explicit disconnect.
SARAE_R2_ACCOUNT_ID=
SARAE_R2_BUCKET=
SARAE_R2_ACCESS_KEY_ID=
SARAE_R2_SECRET_ACCESS_KEY=
# Optional: auto-generated from Account ID
SARAE_R2_ENDPOINT=
SARAE_R2_REGION=auto
# Legacy Google Drive (only needed to access existing Drive media)
SARAE_GOOGLE_CLIENT_ID=
SARAE_GOOGLE_CLIENT_SECRET=
SARAE_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/storage-admin/google/callback
SARAE_WEB_APP_URL=http://localhost:5173
# Required in production so restarts/servers share the key that encrypts the storage refresh token
SARAE_CREDENTIAL_KEY=
SARAE_URL_SIGNING_SECRET=
# Optional limits (bytes); quota 0 = unlimited
SARAE_MEDIA_MAX_UPLOAD_BYTES=4294967296
SARAE_MEDIA_OWNER_QUOTA_BYTES=0

# G-OmniVoice TTS Backend (voice-server/, docs/TTS_SERVER.md section 17). Empty URL = provider "omnivoice" unavailable.
# The orchestrator token stays on this server; it is never sent to the Web or to an Agent.
SARAE_TTS_SERVER_URL=
SARAE_TTS_SERVER_TOKEN=
# Address a Windows Agent may use to download audio directly (LAN/VPN, Phase 4). Empty = Backend relay only.
SARAE_TTS_AGENT_URL=
SARAE_TTS_TIMEOUT_SECONDS=10
SARAE_TTS_LEASE_TTL_SECONDS=60
SARAE_TTS_RELAY_MAX_BYTES=33554432
