{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sarae Live Studio",
  "mainBinaryName": "SaraeAgent",
  "version": "0.3.0",
  "identifier": "vn.sarae.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sarae Live Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0f1420"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sarae",
    "category": "Utility",
    "shortDescription": "Sarae Live Studio",
    "longDescription": "Studio LIVE chạy trên máy: sản phẩm, thư viện video, OBS và trả lời bình luận. Dữ liệu khách nằm trong AppData, không nằm cạnh ứng dụng.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sarae-agent-core"],
    "resources": {
      "resources/ffmpeg/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "resources/ffmpeg/ffprobe.exe": "ffmpeg/ffprobe.exe",
      "resources/ffmpeg/LICENSE.txt": "ffmpeg/LICENSE.txt",
      "resources/ffmpeg/VERSION.txt": "ffmpeg/VERSION.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
