# Copy to voice-server\.env (ignored by Git). scripts\run.ps1 creates it with a random token when missing.
# Required: the API never starts without a token. Comma separated to rotate (old,new).
SARAE_VOICE_ORCHESTRATOR_TOKENS=
# Optional admin token(s); admin can call everything the orchestrator can.
SARAE_VOICE_ADMIN_TOKENS=

# Loopback only by default. For a LAN/VPN, set the private interface address, never 0.0.0.0 on a public network.
SARAE_VOICE_HOST=127.0.0.1
SARAE_VOICE_PORT=8780
SARAE_VOICE_DATA_DIR=data
SARAE_VOICE_DEVICE=cuda:0

# Pinned to the verified Phase 0 baseline; changing these invalidates every cached prompt.
SARAE_VOICE_CHECKPOINT=g-group-ai-lab/g-omnivoice
SARAE_VOICE_CHECKPOINT_REVISION=f2b73211e57db389d81ab817987f90c02e0898ba
SARAE_VOICE_OMNIVOICE_VERSION=0.2.1
SARAE_VOICE_STRICT_VERSIONS=true

# Limits
SARAE_VOICE_MAX_TEXT_CHARS=450
SARAE_VOICE_MAX_WAV_BYTES=5242880
# Bounded queue per priority class (queued calls; one more may be running)
SARAE_VOICE_QUEUE_LIVE=8
SARAE_VOICE_QUEUE_PREVIEW=4
SARAE_VOICE_QUEUE_PREPARE=50
SARAE_VOICE_QUEUE_LONG=5
SARAE_VOICE_QUEUE_BENCHMARK=2
SARAE_VOICE_QUEUE_TIMEOUT_S=30
SARAE_VOICE_PROMPT_RAM_CACHE=16
# Keep every synchronous WAV + metadata under data\outputs (debug; removed after SARAE_VOICE_RESULT_TTL_S).
SARAE_VOICE_SAVE_OUTPUTS=false

# --- Phase 2: jobs, scheduling, LIVE admission, results, operation ---
SARAE_VOICE_JOB_MAX_CHARS=5000
SARAE_VOICE_STARVATION_S=30
SARAE_VOICE_FAIR_EVERY=4
SARAE_VOICE_MAX_DEADLINE_S=3600
SARAE_VOICE_JOB_RETENTION_S=900
SARAE_VOICE_RESULT_TTL_S=86400
SARAE_VOICE_RESULT_MAX_BYTES=1073741824
SARAE_VOICE_MAX_OUTPUT_BYTES=33554432
SARAE_VOICE_READ_TOKEN_MAX_TTL_S=900
# Empty = random per process (read tokens end with the in-memory jobs on restart).
SARAE_VOICE_READ_TOKEN_SECRET=
SARAE_VOICE_LIVE_LEASE_MAX_TTL_S=300
SARAE_VOICE_PREPARE_LIVE_MAX_AUDIO_S=20
SARAE_VOICE_CLEANUP_INTERVAL_S=300
SARAE_VOICE_SHUTDOWN_GRACE_S=30
SARAE_VOICE_EXIT_ON_GPU_FAILURE=true

# Hugging Face: after the first download the checkpoint loads from the local cache.
# HF_HOME=D:\hf-cache
# HF_HUB_OFFLINE=1
