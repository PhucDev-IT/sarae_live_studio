{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ui:prepare": "node scripts/prepare-ui-core.mjs",
    "predev": "npm run ui:prepare",
    "dev": "vite",
    "build": "npm run ui:prepare && npm run build:app",
    "build:app": "tsc -b && vite build",
    "build:overlay": "vite build --config vite.overlay.config.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "axios": "^1.20.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
